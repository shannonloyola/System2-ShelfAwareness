SCM_SUPPLIER_PORT=4001
NODE_ENV=development

# Supabase/Postgres connection string
# Example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SCM_SUPPLIER_DATABASE_URL=

# Set to false if your database does not require SSL.
SCM_SUPPLIER_DB_SSL=true

# Optional: API base URL that frontend can call later
SCM_SUPPLIER_SUPPLIER_SERVICE_URL=http://localhost:4001
