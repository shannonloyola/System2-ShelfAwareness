FROM node:20-alpine AS builder
WORKDIR /app

# Declare build-time env vars (NEXT_PUBLIC_* must be baked in at build time)
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_SUPPLY_CHAIN_URL
ARG NEXT_PUBLIC_SUPABASE_SUPPLY_CHAIN_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_FULFILLMENT_URL
ARG NEXT_PUBLIC_SUPABASE_FULFILLMENT_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_QUALITY_URL
ARG NEXT_PUBLIC_SUPABASE_QUALITY_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_SUPPORT_INTEL_URL
ARG NEXT_PUBLIC_SUPABASE_SUPPORT_INTEL_ANON_KEY
ARG NEXT_PUBLIC_BACKEND_API_URL
ARG NEXT_PUBLIC_SUPPLIER_SERVICE_URL
ARG NEXT_PUBLIC_PROCUREMENT_SERVICE_URL
ARG NEXT_PUBLIC_PRODUCT_CATALOG_SERVICE_URL
ARG NEXT_PUBLIC_INVENTORY_SERVICE_URL
ARG NEXT_PUBLIC_WAREHOUSE_RECEIVING_SERVICE_URL
ARG NEXT_PUBLIC_DISTRIBUTION_SERVICE_URL
ARG NEXT_PUBLIC_DISCREPANCY_QC_SERVICE_URL
ARG NEXT_PUBLIC_STOCK_ADJUSTMENT_SERVICE_URL
ARG NEXT_PUBLIC_AUTH_USER_ACCESS_SERVICE_URL

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_SUPPLY_CHAIN_URL=$NEXT_PUBLIC_SUPABASE_SUPPLY_CHAIN_URL
ENV NEXT_PUBLIC_SUPABASE_SUPPLY_CHAIN_ANON_KEY=$NEXT_PUBLIC_SUPABASE_SUPPLY_CHAIN_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_FULFILLMENT_URL=$NEXT_PUBLIC_SUPABASE_FULFILLMENT_URL
ENV NEXT_PUBLIC_SUPABASE_FULFILLMENT_ANON_KEY=$NEXT_PUBLIC_SUPABASE_FULFILLMENT_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_QUALITY_URL=$NEXT_PUBLIC_SUPABASE_QUALITY_URL
ENV NEXT_PUBLIC_SUPABASE_QUALITY_ANON_KEY=$NEXT_PUBLIC_SUPABASE_QUALITY_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_SUPPORT_INTEL_URL=$NEXT_PUBLIC_SUPABASE_SUPPORT_INTEL_URL
ENV NEXT_PUBLIC_SUPABASE_SUPPORT_INTEL_ANON_KEY=$NEXT_PUBLIC_SUPABASE_SUPPORT_INTEL_ANON_KEY
ENV NEXT_PUBLIC_BACKEND_API_URL=$NEXT_PUBLIC_BACKEND_API_URL
ENV NEXT_PUBLIC_SUPPLIER_SERVICE_URL=$NEXT_PUBLIC_SUPPLIER_SERVICE_URL
ENV NEXT_PUBLIC_PROCUREMENT_SERVICE_URL=$NEXT_PUBLIC_PROCUREMENT_SERVICE_URL
ENV NEXT_PUBLIC_PRODUCT_CATALOG_SERVICE_URL=$NEXT_PUBLIC_PRODUCT_CATALOG_SERVICE_URL
ENV NEXT_PUBLIC_INVENTORY_SERVICE_URL=$NEXT_PUBLIC_INVENTORY_SERVICE_URL
ENV NEXT_PUBLIC_WAREHOUSE_RECEIVING_SERVICE_URL=$NEXT_PUBLIC_WAREHOUSE_RECEIVING_SERVICE_URL
ENV NEXT_PUBLIC_DISTRIBUTION_SERVICE_URL=$NEXT_PUBLIC_DISTRIBUTION_SERVICE_URL
ENV NEXT_PUBLIC_DISCREPANCY_QC_SERVICE_URL=$NEXT_PUBLIC_DISCREPANCY_QC_SERVICE_URL
ENV NEXT_PUBLIC_STOCK_ADJUSTMENT_SERVICE_URL=$NEXT_PUBLIC_STOCK_ADJUSTMENT_SERVICE_URL
ENV NEXT_PUBLIC_AUTH_USER_ACCESS_SERVICE_URL=$NEXT_PUBLIC_AUTH_USER_ACCESS_SERVICE_URL

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source and build
COPY . .
RUN npm run build

# Production runner using standalone output
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5173
ENV HOSTNAME=0.0.0.0

# Copy only what's needed from the builder
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 5173

CMD ["node", "server.js"]
