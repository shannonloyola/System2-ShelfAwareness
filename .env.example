# --- Global Environment Variables ---
NODE_ENV=production
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DB_SSL=true
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
CRON_TIMEZONE=Asia/Manila

# --- Frontend ---
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPPLIER_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_AUTH_USER_ACCESS_SERVICE_URL=http://localhost:4014

# --- Supabase Identity Project ---
NEXT_PUBLIC_SUPABASE_URL=your_identity_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_identity_anon_key_here

# --- Supabase Supply Chain Project ---
NEXT_PUBLIC_SUPABASE_SUPPLY_CHAIN_URL=your_supply_chain_url_here
NEXT_PUBLIC_SUPABASE_SUPPLY_CHAIN_ANON_KEY=your_supply_chain_anon_key_here
SCM_SUPABASE_URL=your_supply_chain_url_here
SCM_SUPABASE_ANON_KEY=your_supply_chain_anon_key_here
SCM_SUPABASE_SERVICE_ROLE_KEY=your_supply_chain_service_role_key_here

# --- Supabase Fulfillment Project ---
NEXT_PUBLIC_SUPABASE_FULFILLMENT_URL=your_fulfillment_url_here
NEXT_PUBLIC_SUPABASE_FULFILLMENT_ANON_KEY=your_fulfillment_anon_key_here
SUPABASE_FULFILLMENT_SERVICE_ROLE_KEY=your_fulfillment_service_role_key_here

# --- Domain 4: Quality & Compliance Project ---
DOMAIN4_SUPABASE_URL=your_quality_url_here
DOMAIN4_SUPABASE_ANON_KEY=your_quality_anon_key_here
NEXT_PUBLIC_SUPABASE_QUALITY_URL=your_quality_url_here
NEXT_PUBLIC_SUPABASE_QUALITY_ANON_KEY=your_quality_anon_key_here

# --- Domain 5: Support & Intel Project ---
DOMAIN5_SUPABASE_URL=your_support_intel_url_here
DOMAIN5_SUPABASE_ANON_KEY=your_support_intel_anon_key_here
NEXT_PUBLIC_SUPABASE_SUPPORT_INTEL_URL=your_support_intel_url_here
NEXT_PUBLIC_SUPABASE_SUPPORT_INTEL_ANON_KEY=your_support_intel_anon_key_here

# --- Service URLs (Internal Docker Communication) ---
# These are used by backend/services to talk to each other inside the Docker network.
# In local development outside Docker, change these to http://localhost:PORT
SUPPLIER_SERVICE_URL=http://supplier-service:4001
PROCUREMENT_SERVICE_URL=http://procurement-service:4002
PRODUCT_CATALOG_SERVICE_URL=http://product-catalog-service:4003
INVENTORY_SERVICE_URL=http://inventory-service:4004
WAREHOUSE_RECEIVING_SERVICE_URL=http://warehouse-receiving-service:4005
DISTRIBUTION_SERVICE_URL=http://distribution-service:4006
DISCREPANCY_QC_SERVICE_URL=http://discrepancy-qc-service:4007
STOCK_ADJUSTMENT_SERVICE_URL=http://stock-adjustment-service:4008
CYCLE_COUNTING_SERVICE_URL=http://cycle-counting-service:4009
RISK_COMPLIANCE_SERVICE_URL=http://risk-compliance-service:4010
NOTIFICATION_SERVICE_URL=http://notification-service:4011
REPORTING_ANALYTICS_SERVICE_URL=http://reporting-analytics-service:4012
DOCUMENT_SERVICE_URL=http://document-service:4013
AUTH_USER_ACCESS_SERVICE_URL=http://auth-user-access-service:4014
BACKEND_API_URL=http://pharma-backend:3001
